# ============================================================
# VendorSync AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to GitHub.
# ============================================================

# --- Database ---
# Leave blank to use local SQLite (default for development).
# Add a PostgreSQL connection string to connect a real database.
# Supported formats:
#   Supabase:  postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   Railway:   postgresql://postgres:<password>@<host>:<port>/railway
#   Neon:      postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Google Gemini AI ---
# Get a free key at https://aistudio.google.com/app/apikey
# Without this key, the app uses the built-in Smart Local AI Engine (fully offline).
GEMINI_API_KEY=

# Gemini model to use (gemini-1.5-flash recommended — fast and free tier)
GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI (Alternative AI — optional) ---
# Only needed if you prefer OpenAI GPT instead of Gemini.
OPENAI_API_KEY=

# --- App Settings ---
# JWT secret key — change this to a long random string in production!
JWT_SECRET_KEY=vendorsync-super-secret-key-change-me-in-production

# Server port
PORT=8000
